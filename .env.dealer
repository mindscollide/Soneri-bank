PUBLIC_URL=.
VITE_APP_INCLUDE_DEALER=true
VITE_APP_INCLUDE_TREASURY=false
VITE_APP_INCLUDE_MANAGEMENT=false
VITE_MQTT_PORT=8883
VITE_MQTT_HOST=Soneritrade.tresmark.com
VITE_MQTT_USERNAME=user1
VITE_MQTT_PASSWORD=password1
VITE_BASE_URL=https://Soneritrade.tresmark.com:6010
VITE_AUTH_PORT=/SBLAuth
VITE_WATCHLIST_PORT=/SBLWatchlist
VITE_BOP_KEY=TRADEANDTREASURYAuth
VITE_ALLOWED_EMAIL_DOMAIN=yopmail.com
VITE_ENV="UAT"


